<!--begin::Toolbar-->
<div class="toolbar py-3 py-lg-6" id="kt_toolbar">
    <div class="container-xxl d-flex flex-stack flex-wrap gap-2">
        <div class="page-title d-flex flex-column justify-content-center me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                Clientes
            </h1>

            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                <li class="breadcrumb-item text-muted">
                    <a href="/" class="text-muted text-hover-primary">Inicio</a>
                </li>
                <li class="breadcrumb-item">
                    <span class="bullet bg-gray-400 w-5px h-2px"></span>
                </li>
                <li class="breadcrumb-item text-dark">Clientes</li>
            </ul>
        </div>

        <div class="d-flex align-items-center gap-2 gap-lg-3">
            <a href="/prestamos/nuevo" class="btn btn-primary">
                Nuevo préstamo
            </a>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <div class="container-xxl" id="kt_content_container">

        <div class="card gc-elevated">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
            <span class="svg-icon svg-icon-1 position-absolute ms-6">
              <i class="ki-duotone ki-magnifier fs-2">
                <span class="path1"></span><span class="path2"></span>
              </i>
            </span>

                        <input
                                type="text"
                                data-kt-clientes-table-filter="search"
                                class="form-control form-control-solid w-250px ps-15"
                                placeholder="Buscar cliente..."
                        />
                    </div>
                </div>

                <div class="card-toolbar">
                    <div class="d-flex justify-content-end gap-2" data-kt-clientes-table-toolbar="base">

                        <select class="form-select form-select-solid w-200px"
                                data-kt-clientes-table-filter="estado">
                            <option value="">Todos los estados</option>
                            <option value="AC">Activos</option>
                            <option value="IN">Inactivos</option>
                            <option value="BL">Bloqueados</option>
                        </select>

                        <button type="button" class="btn btn-light" data-kt-clientes-table-filter="reset">
                            Limpiar
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table align-middle table-row-dashed fs-6 gy-3" id="kt_table_clientes">
                        <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th class="min-w-90px">ID</th>
                            <th class="min-w-220px">Cliente</th>
                            <th class="min-w-140px">CUI</th>
                            <th class="min-w-140px">Teléfono</th>
                            <th class="min-w-180px">Cartera</th>
                            <th class="min-w-120px">Estado</th>
                            <th class="min-w-120px text-end">Acciones</th>
                        </tr>
                        </thead>
                        <tbody class="text-gray-600 fw-semibold"></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>