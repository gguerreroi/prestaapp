<!--begin::Toolbar-->
<div class="toolbar py-3 py-lg-6" id="kt_toolbar">
    <div class="container-xxl d-flex flex-stack flex-wrap gap-2">
        <div class="page-title d-flex flex-column justify-content-center me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                Reportes
            </h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                <li class="breadcrumb-item text-muted">
                    <a href="/" class="text-muted text-hover-primary">Inicio</a>
                </li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-400 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-dark">Reportes</li>
            </ul>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <div class="container-xxl" id="kt_content_container">

        <div class="row g-5 g-xl-8">

            <!-- Cuadro semanal de cobranza -->
            <div class="col-xl-4 col-md-6">
                <a href="/reportes/cobranza-semanal" class="card card-xl-stretch mb-xl-8 card-hover text-decoration-none">
                    <div class="card-body d-flex flex-column align-items-start p-8">
                        <div class="symbol symbol-50px mb-5">
                            <span class="symbol-label bg-light-primary">
                                <i class="ki-duotone ki-calendar fs-2x text-primary">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                            </span>
                        </div>
                        <h3 class="fs-4 fw-bold text-gray-800 mb-2">Cuadro semanal de cobranza</h3>
                        <p class="text-muted fw-semibold fs-7 mb-0">
                            Tabla de clientes con pagos programados de lunes a domingo, saldos y fechas de la semana.
                        </p>
                        <span class="badge badge-light-warning mt-4">Proximamente</span>
                    </div>
                </a>
            </div>

            <!-- Resumen general -->
            <div class="col-xl-4 col-md-6">
                <div class="card card-xl-stretch mb-xl-8">
                    <div class="card-body d-flex flex-column align-items-start p-8">
                        <div class="symbol symbol-50px mb-5">
                            <span class="symbol-label bg-light-success">
                                <i class="ki-duotone ki-chart-simple fs-2x text-success">
                                    <span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span>
                                </i>
                            </span>
                        </div>
                        <h3 class="fs-4 fw-bold text-gray-800 mb-2">Resumen general</h3>
                        <p class="text-muted fw-semibold fs-7 mb-0">
                            KPIs de prestamos activos, capital colocado, mora total y cobranza del dia.
                        </p>
                        <span class="badge badge-light-warning mt-4">Proximamente</span>
                    </div>
                </div>
            </div>

            <!-- Reporte por cartera / agente -->
            <div class="col-xl-4 col-md-6">
                <div class="card card-xl-stretch mb-xl-8">
                    <div class="card-body d-flex flex-column align-items-start p-8">
                        <div class="symbol symbol-50px mb-5">
                            <span class="symbol-label bg-light-info">
                                <i class="ki-duotone ki-people fs-2x text-info">
                                    <span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span>
                                </i>
                            </span>
                        </div>
                        <h3 class="fs-4 fw-bold text-gray-800 mb-2">Reporte por cartera / agente</h3>
                        <p class="text-muted fw-semibold fs-7 mb-0">
                            Desempeno de cada agente de cobranza: prestamos asignados, cobros realizados y atrasos.
                        </p>
                        <span class="badge badge-light-warning mt-4">Proximamente</span>
                    </div>
                </div>
            </div>

            <!-- Reporte de morosidad -->
            <div class="col-xl-4 col-md-6">
                <div class="card card-xl-stretch mb-xl-8">
                    <div class="card-body d-flex flex-column align-items-start p-8">
                        <div class="symbol symbol-50px mb-5">
                            <span class="symbol-label bg-light-danger">
                                <i class="ki-duotone ki-time fs-2x text-danger">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                            </span>
                        </div>
                        <h3 class="fs-4 fw-bold text-gray-800 mb-2">Reporte de morosidad</h3>
                        <p class="text-muted fw-semibold fs-7 mb-0">
                            Listado de prestamos con atrasos, dias de mora y montos pendientes por cobrar.
                        </p>
                        <span class="badge badge-light-warning mt-4">Proximamente</span>
                    </div>
                </div>
            </div>

            <!-- Reporte de pagos diarios -->
            <div class="col-xl-4 col-md-6">
                <div class="card card-xl-stretch mb-xl-8">
                    <div class="card-body d-flex flex-column align-items-start p-8">
                        <div class="symbol symbol-50px mb-5">
                            <span class="symbol-label bg-light-warning">
                                <i class="ki-duotone ki-wallet fs-2x text-warning">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                            </span>
                        </div>
                        <h3 class="fs-4 fw-bold text-gray-800 mb-2">Reporte de pagos diarios</h3>
                        <p class="text-muted fw-semibold fs-7 mb-0">
                            Detalle de pagos recibidos por dia o rango de fechas con totales y desglose.
                        </p>
                        <span class="badge badge-light-warning mt-4">Proximamente</span>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
