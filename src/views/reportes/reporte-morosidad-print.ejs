<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reporte de Morosidad - <%= mesLabel %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, Helvetica, sans-serif; font-size: 9px; color: #333; padding: 5mm; }
        .header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 10px; border-bottom: 2px solid #c62828; padding-bottom: 6px; }
        .header-title { font-size: 16px; font-weight: bold; color: #c62828; }
        .header-sub { font-size: 10px; color: #666; }
        .header-right { text-align: right; font-size: 8px; color: #888; }

        .kpis { display: flex; gap: 10px; margin-bottom: 12px; }
        .kpi { border: 1px solid #ddd; border-radius: 4px; padding: 6px 10px; text-align: center; flex: 1; }
        .kpi-label { font-size: 7px; color: #888; text-transform: uppercase; }
        .kpi-value { font-size: 14px; font-weight: bold; }
        .text-danger { color: #c62828; }
        .text-warning { color: #e65100; }
        .text-success { color: #1b7a1b; }

        table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
        th, td { border: 1px solid #ccc; padding: 3px 5px; vertical-align: middle; }
        th { background-color: #fce4ec; font-weight: bold; font-size: 7px; text-transform: uppercase; text-align: center; }
        th.text-end, td.text-end { text-align: right; }
        td.text-start { text-align: left; }
        td.text-center { text-align: center; }
        .totals-row td { background-color: #fce4ec; font-weight: bold; border-top: 2px solid #c62828; }

        .badge { display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 8px; font-weight: bold; }
        .badge-danger { background: #fce4ec; color: #c62828; }
        .badge-warning { background: #fff3e0; color: #e65100; }
        .badge-light { background: #f5f5f5; color: #666; }

        .footer { margin-top: 10px; text-align: center; font-size: 7px; color: #aaa; }
    </style>
</head>
<body>

<%
    const Q = (v) => 'Q' + Number(v || 0).toLocaleString('es-GT');
    const fmtD = (d) => d ? new Date(d).toLocaleDateString('es-GT', { timeZone: 'UTC', day: '2-digit', month: '2-digit', year: '2-digit' }) : '-';
%>

<div class="header">
    <div>
        <div class="header-title">Reporte de Morosidad</div>
        <div class="header-sub"><%= mesLabel %> &mdash; Agente: <strong><%= agenteName %></strong></div>
    </div>
    <div class="header-right">
        PrestaApp<br>
        Generado: <%= new Date().toLocaleString('es-GT', { dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Guatemala' }) %>
    </div>
</div>

<div class="kpis">
    <div class="kpi">
        <div class="kpi-label">Morosos</div>
        <div class="kpi-value text-danger"><%= kpis.totalMorosos %> / <%= kpis.totalActivos %></div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Tasa morosidad</div>
        <div class="kpi-value text-danger"><%= kpis.tasaMorosidad %>%</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Cuotas atrasadas</div>
        <div class="kpi-value"><%= kpis.totalCuotasAtrasadas %></div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Monto cuotas</div>
        <div class="kpi-value text-warning"><%= Q(kpis.totalMontoCuotasAtrasadas) %></div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Mora acumulada</div>
        <div class="kpi-value text-danger"><%= Q(kpis.totalMontoMora) %></div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Total pendiente</div>
        <div class="kpi-value"><%= Q(kpis.totalPendiente) %></div>
    </div>
</div>

<table>
    <thead>
    <tr>
        <th style="width:30px;">ID</th>
        <th style="width:140px; text-align:left;">Cliente</th>
        <th style="width:90px; text-align:left;">Agente</th>
        <th style="width:45px;">Inicio</th>
        <th class="text-end" style="width:55px;">Principal</th>
        <th class="text-end" style="width:55px;">Saldo</th>
        <th style="width:40px;">Cuotas</th>
        <th style="width:45px;">Dias mora</th>
        <th class="text-end" style="width:60px;">Monto cuotas</th>
        <th class="text-end" style="width:50px;">Mora</th>
        <th class="text-end" style="width:60px;">Total deuda</th>
    </tr>
    </thead>
    <tbody>
    <% if (prestamos.length === 0) { %>
        <tr><td colspan="11" style="text-align:center; padding:15px; color:#999;">No hay prestamos con atrasos.</td></tr>
    <% } else { %>
        <% prestamos.forEach(function(p) { %>
            <%
                const deudaTotal = p.monto_cuotas_atrasadas + p.monto_mora;
                const badgeClass = p.dias_mora_max >= 14 ? 'badge-danger' : p.dias_mora_max >= 7 ? 'badge-warning' : 'badge-light';
            %>
            <tr>
                <td class="text-center">#<%= p.prestamo_id %></td>
                <td class="text-start">
                    <strong><%= p.cliente_nombre %></strong>
                    <% if (p.cliente_telefono) { %><div style="font-size:7px; color:#999;">Tel: <%= p.cliente_telefono %></div><% } %>
                </td>
                <td class="text-start" style="font-size:8px;"><%= p.agente_nombre %></td>
                <td class="text-center"><%= fmtD(p.fecha_inicio) %></td>
                <td class="text-end"><%= Q(p.principal) %></td>
                <td class="text-end" style="font-weight:bold;"><%= Q(p.saldo) %></td>
                <td class="text-center"><span class="badge badge-danger"><%= p.cuotas_atrasadas %></span></td>
                <td class="text-center"><span class="badge <%= badgeClass %>"><%= p.dias_mora_max %> d</span></td>
                <td class="text-end text-warning"><%= Q(p.monto_cuotas_atrasadas) %></td>
                <td class="text-end text-danger"><%= Q(p.monto_mora) %></td>
                <td class="text-end" style="font-weight:bold;"><%= Q(deudaTotal) %></td>
            </tr>
        <% }) %>
    <% } %>
    </tbody>
    <% if (prestamos.length > 0) { %>
    <tfoot>
        <tr class="totals-row">
            <td colspan="6" style="text-align:left; padding-left:5px;">TOTALES</td>
            <td class="text-center"><%= kpis.totalCuotasAtrasadas %></td>
            <td></td>
            <td class="text-end"><%= Q(kpis.totalMontoCuotasAtrasadas) %></td>
            <td class="text-end text-danger"><%= Q(kpis.totalMontoMora) %></td>
            <td class="text-end" style="font-weight:bold;"><%= Q(kpis.totalPendiente) %></td>
        </tr>
    </tfoot>
    <% } %>
</table>

<div class="footer">PrestaApp &mdash; Reporte generado automaticamente</div>

</body>
</html>
