<!--begin::Toolbar-->
<div class="toolbar py-3 py-lg-6" id="kt_toolbar">
    <div class="container-xxl d-flex flex-stack flex-wrap gap-2">
        <div class="page-title d-flex flex-column justify-content-center me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                Cobranza Mensual
            </h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                <li class="breadcrumb-item text-muted"><a href="/" class="text-muted text-hover-primary">Inicio</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-400 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-muted"><a href="/reportes" class="text-muted text-hover-primary">Reportes</a></li>
                <li class="breadcrumb-item"><span class="bullet bg-gray-400 w-5px h-2px"></span></li>
                <li class="breadcrumb-item text-dark">Cobranza Mensual</li>
            </ul>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <div class="container-xxl" id="kt_content_container">

        <!-- Filtros y navegacion -->
        <div class="card mb-5">
            <div class="card-body py-5">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">

                    <!-- Navegacion de meses -->
                    <div class="d-flex align-items-center gap-2">
                        <a href="/reportes/cobranza-mensual?mes=<%= mesAnterior %><%= filtroAgente ? '&agente=' + filtroAgente : '' %>"
                           class="btn btn-icon btn-sm btn-light" title="Mes anterior">
                            <i class="bi bi-chevron-left"></i>
                        </a>

                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-calendar3 text-primary"></i>
                            <span class="fw-bold fs-5 text-gray-800"><%= mesLabel %></span>
                            <input type="month" id="inputMes" class="form-control form-control-sm form-control-solid w-150px"
                                   value="<%= mesActual %>" />
                        </div>

                        <a href="/reportes/cobranza-mensual?mes=<%= mesSiguiente %><%= filtroAgente ? '&agente=' + filtroAgente : '' %>"
                           class="btn btn-icon btn-sm btn-light" title="Mes siguiente">
                            <i class="bi bi-chevron-right"></i>
                        </a>

                        <a href="/reportes/cobranza-mensual<%= filtroAgente ? '?agente=' + filtroAgente : '' %>"
                           class="btn btn-sm btn-light-primary ms-2">Mes actual</a>
                    </div>

                    <!-- Filtro por agente -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted fs-7">Agente:</span>
                        <select class="form-select form-select-solid form-select-sm w-200px" id="fltAgente">
                            <option value="">Todos</option>
                            <% agentes.forEach(function(ag) { %>
                                <option value="<%= ag.agente_id %>" <%= filtroAgente == ag.agente_id ? 'selected' : '' %>>
                                    <%= ag.nombre %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Exportar -->
                    <div class="d-flex align-items-center gap-2">
                        <a href="/reportes/cobranza-mensual/excel?mes=<%= mesActual %><%= filtroAgente ? '&agente=' + filtroAgente : '' %>"
                           class="btn btn-sm btn-light-success" title="Descargar Excel">
                            <i class="bi bi-file-earmark-spreadsheet"></i> Excel
                        </a>
                        <a href="/reportes/cobranza-mensual/pdf?mes=<%= mesActual %><%= filtroAgente ? '&agente=' + filtroAgente : '' %>"
                           class="btn btn-sm btn-light-danger" title="Ver PDF" target="_blank">
                            <i class="bi bi-file-earmark-pdf"></i> PDF
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPIs -->
        <div class="row g-5 mb-5">
            <div class="col-md-3">
                <div class="card card-body text-center py-4">
                    <span class="text-muted fs-7">Capital colocado en el mes</span>
                    <span class="fs-2 fw-bold text-primary">Q <%= kpis.capitalColocadoMes.toLocaleString('es-GT') %></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-body text-center py-4">
                    <span class="text-muted fs-7">Saldo total cartera</span>
                    <span class="fs-2 fw-bold text-gray-800">Q <%= kpis.totalSaldo.toLocaleString('es-GT') %></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-body text-center py-4">
                    <span class="text-muted fs-7">Cobrado en el mes</span>
                    <span class="fs-2 fw-bold text-success">Q <%= kpis.cobradoEnMes.toLocaleString('es-GT') %></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-body text-center py-4">
                    <span class="text-muted fs-7">Prestamos activos</span>
                    <span class="fs-2 fw-bold text-gray-800"><%= prestamos.length %></span>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-row-dashed align-middle gs-0 gy-2 mb-0 fs-8">
                        <thead>
                            <!-- Fila de grupos -->
                            <tr class="fw-bold text-muted text-uppercase bg-light">
                                <th rowspan="2" class="ps-4 text-center align-middle">No.</th>
                                <th rowspan="2" class="align-middle min-w-180px">Cliente</th>
                                <th rowspan="2" class="align-middle text-center">Inicio</th>
                                <th rowspan="2" class="align-middle text-center">Fin</th>
                                <th rowspan="2" class="align-middle text-end">Principal</th>
                                <th rowspan="2" class="align-middle text-end">Saldo</th>
                                <% semanas.forEach(function(s) { %>
                                    <th colspan="3" class="text-center border-start">Sem <%= s.label %></th>
                                <% }) %>
                                <th colspan="3" class="text-center border-start bg-light-primary">Total</th>
                            </tr>
                            <!-- Fila de sub-columnas -->
                            <tr class="fw-bold text-muted text-uppercase bg-light fs-9">
                                <% for (let i = 0; i < 5; i++) { %>
                                    <th class="text-end border-start">Cuota</th>
                                    <th class="text-end">Mora</th>
                                    <th class="text-end">Admon</th>
                                <% } %>
                            </tr>
                        </thead>
                        <tbody class="fw-semibold text-gray-700">
                            <% if (prestamos.length === 0) { %>
                                <tr><td colspan="21" class="text-center text-muted py-8">No hay prestamos activos en este mes.</td></tr>
                            <% } else { %>
                                <%
                                    const fmtD = (d) => d ? new Date(d).toLocaleDateString('es-GT', { timeZone: 'UTC', day: '2-digit', month: '2-digit' }) : '-';
                                %>
                                <% prestamos.forEach(function(p, idx) { %>
                                    <%
                                        const totC = p.semanas.reduce((s, w) => s + w.cuota, 0);
                                        const totM = p.semanas.reduce((s, w) => s + w.mora, 0);
                                        const totA = p.semanas.reduce((s, w) => s + w.admon, 0);
                                    %>
                                    <tr>
                                        <td class="ps-4 text-center text-muted"><%= idx + 1 %></td>
                                        <td>
                                            <a href="/prestamos/<%= p.prestamo_id %>" class="text-gray-800 fw-bold text-hover-primary">
                                                <%= p.cliente_nombre %>
                                            </a>
                                            <div class="text-muted fs-9">#<%= p.prestamo_id %> &middot; Q<%= p.cuota_diaria %>/dia</div>
                                        </td>
                                        <td class="text-center"><%= fmtD(p.fecha_inicio) %></td>
                                        <td class="text-center"><%= fmtD(p.fecha_fin) %></td>
                                        <td class="text-end">Q <%= p.principal.toLocaleString('es-GT') %></td>
                                        <td class="text-end fw-bold">Q <%= p.saldo.toLocaleString('es-GT') %></td>
                                        <% p.semanas.forEach(function(w) { %>
                                            <td class="text-end border-start"><%= w.cuota ? 'Q' + w.cuota.toLocaleString('es-GT') : '-' %></td>
                                            <td class="text-end"><%= w.mora ? '<span class="text-danger">Q' + w.mora.toLocaleString('es-GT') + '</span>' : '-' %></td>
                                            <td class="text-end"><%= w.admon ? '<span class="text-primary">Q' + w.admon.toLocaleString('es-GT') + '</span>' : '-' %></td>
                                        <% }) %>
                                        <td class="text-end border-start fw-bold"><%= totC ? 'Q' + totC.toLocaleString('es-GT') : '-' %></td>
                                        <td class="text-end fw-bold"><%= totM ? '<span class="text-danger">Q' + totM.toLocaleString('es-GT') + '</span>' : '-' %></td>
                                        <td class="text-end fw-bold"><%= totA ? '<span class="text-primary">Q' + totA.toLocaleString('es-GT') + '</span>' : '-' %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                        <% if (prestamos.length > 0) { %>
                        <tfoot>
                            <tr class="fw-bold bg-light-primary">
                                <td colspan="4" class="ps-4">TOTALES</td>
                                <td class="text-end">Q <%= prestamos.reduce((s, p) => s + p.principal, 0).toLocaleString('es-GT') %></td>
                                <td class="text-end">Q <%= prestamos.reduce((s, p) => s + p.saldo, 0).toLocaleString('es-GT') %></td>
                                <% for (let si = 0; si < 4; si++) { %>
                                    <td class="text-end border-start">Q <%= prestamos.reduce((s, p) => s + p.semanas[si].cuota, 0).toLocaleString('es-GT') %></td>
                                    <td class="text-end">Q <%= prestamos.reduce((s, p) => s + p.semanas[si].mora, 0).toLocaleString('es-GT') %></td>
                                    <td class="text-end">Q <%= prestamos.reduce((s, p) => s + p.semanas[si].admon, 0).toLocaleString('es-GT') %></td>
                                <% } %>
                                <td class="text-end border-start">Q <%= prestamos.reduce((s, p) => s + p.semanas.reduce((a, w) => a + w.cuota, 0), 0).toLocaleString('es-GT') %></td>
                                <td class="text-end">Q <%= prestamos.reduce((s, p) => s + p.semanas.reduce((a, w) => a + w.mora, 0), 0).toLocaleString('es-GT') %></td>
                                <td class="text-end">Q <%= prestamos.reduce((s, p) => s + p.semanas.reduce((a, w) => a + w.admon, 0), 0).toLocaleString('es-GT') %></td>
                            </tr>
                        </tfoot>
                        <% } %>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
